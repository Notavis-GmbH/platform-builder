# Device settings of this device. Not in git: created from
# app_platform/defaults/.env on the first install, updates keep it.
APP_LICENSECODE=326D2BC480C9C029C445
# Camera power control of the ftdi service: ftdi = power on RTS / button on CTS
# of the FTDI adapter (default), gpio = power and button on header GPIOs
#CONTROL_INTERFACE=gpio
# true (default): power on and start the camera when the ftdi service starts,
# false: power off until the first start
#START_CAMERA_AT_STARTUP=false
# ON: the camera streams without a license file (docker-compose.yml only,
# docker-compose.siemens.yml sets it ON)
#CAMERA_PERFORMANCE_MINUS=ON
